# Copy to .env (git-ignored). Docker Compose loads it into the backend container.
# Nothing here is a real secret. Leave LLM_* empty to run deterministic-only.
PYTHON_ENV=development
LOG_LEVEL=INFO

# --- Docker Compose ports / frontend ---
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# URL the browser uses to reach the API (frontend build-time; public, never a secret)
# VITE_API_BASE_URL=http://localhost:8000

# --- API ---
# Comma-separated browser origins allowed to call the API (empty disables CORS).
# With docker compose this defaults to the frontend origin(s) derived from FRONTEND_PORT.
CORS_ORIGINS=http://localhost:3000
# Where /screen writes and /results reads (relative to /app in Docker).
RESULTS_PATH=output/results.json
MAX_UPLOAD_FILES=200
MAX_UPLOAD_TOTAL_MB=200

# --- LLM semantic analysis (advisory evidence only; never decides eligibility or score) ---
# openrouter | openai | openai_compatible (any OpenAI-style /chat/completions endpoint)
LLM_PROVIDER=openrouter
# Required, no default. Example for OpenRouter: <vendor>/<model-name>
LLM_MODEL=
# Required for the LLM step; without it screening still completes (llm status: unavailable)
LLM_API_KEY=
# Optional: overrides the provider's default endpoint. Required for openai_compatible.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# Max simultaneous model calls. Keep low to respect provider rate limits.
LLM_MAX_CONCURRENCY=3

# --- GitHub enrichment (public REST API; at most 10 points; never affects eligibility) ---
# Optional. Without a token requests are unauthenticated (about 60 requests/hour per IP);
# a token only raises that limit. A fine-grained token with NO permissions is enough.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=10
# Max simultaneous GitHub requests.
GITHUB_MAX_CONCURRENCY=3
