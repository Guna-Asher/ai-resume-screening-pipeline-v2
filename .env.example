# Copy to .env (git-ignored). Docker Compose loads it into the backend container.
# Nothing here is a real secret. Leave LLM_* empty to run deterministic-only.
PYTHON_ENV=development
LOG_LEVEL=INFO

# --- LLM semantic analysis (advisory evidence only; never decides eligibility or score) ---
# openrouter | openai | openai_compatible (any OpenAI-style /chat/completions endpoint)
LLM_PROVIDER=openrouter
# Required, no default. Example for OpenRouter: <vendor>/<model-name>
LLM_MODEL=
# Required for the LLM step; without it screening still completes (llm status: unavailable)
LLM_API_KEY=
# Optional: overrides the provider's default endpoint. Required for openai_compatible.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# Max simultaneous model calls. Keep low to respect provider rate limits.
LLM_MAX_CONCURRENCY=3

# --- Later step: GitHub enrichment ---
GITHUB_TOKEN=
