# Copy to .env (git-ignored). Docker Compose loads it into the backend container.
# Every value is optional in Step 1; nothing here is a real secret.
PYTHON_ENV=development
LOG_LEVEL=INFO

# Later steps: LLM semantic extraction (provider adapter)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Later steps: GitHub enrichment
GITHUB_TOKEN=
